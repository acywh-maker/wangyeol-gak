{
  "$description": "Reading-app style design tokens for a Streamlit web app. Source: dembrandt v0.39.2 extraction of millie.co.kr (2026-10-28, 1920px viewport) + 3 mobile app screenshots. Values marked 'source: web-css' come from the site's own CSS variables; 'web-usage' from usage counts; 'mobile' from screenshot pixel sampling; 'derived' are normalized/estimated values.",

  "color": {
    "gray": {
      "0":    { "$type": "color", "$value": "#FFFFFF", "$description": "source: web-css --ui-background / --ui-up" },
      "50":   { "$type": "color", "$value": "#FBFBFB", "$description": "source: web-css --ui-01" },
      "100":  { "$type": "color", "$value": "#F7F7F7", "$description": "source: web-css --ui-02, --Line-03" },
      "150":  { "$type": "color", "$value": "#F2F2F2", "$description": "source: web-css --ui-03" },
      "200":  { "$type": "color", "$value": "#EFEFEF", "$description": "source: web-css --ui-04" },
      "250":  { "$type": "color", "$value": "#ECECEC", "$description": "source: web-css --ui-05, --Line-02, --quaternary" },
      "300":  { "$type": "color", "$value": "#DFDFDF", "$description": "source: web-css --ui-06, --Line-01" },
      "400":  { "$type": "color", "$value": "#C1C1C1", "$description": "source: web-css --ui-07, --cancel" },
      "500":  { "$type": "color", "$value": "#A5A5A5", "$description": "source: web-css --cancel-press" },
      "600":  { "$type": "color", "$value": "#8B8B8B", "$description": "source: web-css --text-04" },
      "700":  { "$type": "color", "$value": "#6F6F6F", "$description": "source: web-css --text-03 (web-usage 132)" },
      "800":  { "$type": "color", "$value": "#555555", "$description": "source: web-css --text-02, --ui-08" },
      "850":  { "$type": "color", "$value": "#333333", "$description": "source: web-css --ui-09, --secondary" },
      "900":  { "$type": "color", "$value": "#242424", "$description": "source: web-css --text-01, --ui-10 (web-usage 218)" },
      "1000": { "$type": "color", "$value": "#000000", "$description": "source: web-css --text-strong" }
    },
    "yellow": {
      "400": { "$type": "color", "$value": "#FFEB60", "$description": "source: web-css --primary; mobile CTA bar sampled #FEEA61" },
      "500": { "$type": "color", "$value": "#FFE04B", "$description": "source: web-css --primary-press" },
      "600": { "$type": "color", "$value": "#FFBF04", "$description": "source: mobile active tab icon/label" }
    },
    "category": {
      "audio":    { "$type": "color", "$value": "#A451F7", "$description": "source: web-css --audio (was mis-detected as 'primary' by the extractor)" },
      "myaudio":  { "$type": "color", "$value": "#533670", "$description": "source: web-css --myaudio" },
      "chatbook": { "$type": "color", "$value": "#EB683F", "$description": "source: web-css --chatbook" },
      "slate":    { "$type": "color", "$value": "#7091B3", "$description": "source: web-usage 12 (semantic accent)" }
    },
    "focus": { "$type": "color", "$value": "#469FE3", "$description": "source: web-css --focus" },
    "alpha": {
      "line-10": { "$type": "color", "$value": "#9FA3AB1A", "$description": "source: web-css --alpha-10 / --border-alpha-10" },
      "line-15": { "$type": "color", "$value": "#9FA3AB26", "$description": "source: web-css --alpha-15" },
      "line-20": { "$type": "color", "$value": "#9FA3AB33", "$description": "source: web-css --alpha-20" },
      "line-30": { "$type": "color", "$value": "#9FA3AB4D", "$description": "source: web-css --alpha-30" },
      "glass-10": { "$type": "color", "$value": "#B0B3BC1A", "$description": "source: web-css --GTrans-01" },
      "glass-30": { "$type": "color", "$value": "#B0B3BC4D", "$description": "source: web-css --GTrans-02" },
      "glass-50": { "$type": "color", "$value": "#B0B3BC80", "$description": "source: web-css --GTrans-03" },
      "glass-70": { "$type": "color", "$value": "#B0B3BCB3", "$description": "source: web-css --GTrans-04" },
      "dim-30":  { "$type": "color", "$value": "#0000004D", "$description": "source: web button bg rgba(0,0,0,.3)" }
    }
  },

  "semantic": {
    "bg": {
      "default": { "$type": "color", "$value": "{color.gray.0}" },
      "subtle":  { "$type": "color", "$value": "{color.gray.50}" },
      "muted":   { "$type": "color", "$value": "{color.gray.100}" },
      "notice":  { "$type": "color", "$value": "#FAFAF6", "$description": "source: mobile info box (warm off-white)" }
    },
    "text": {
      "strong":    { "$type": "color", "$value": "{color.gray.1000}" },
      "primary":   { "$type": "color", "$value": "{color.gray.900}" },
      "secondary": { "$type": "color", "$value": "{color.gray.800}" },
      "tertiary":  { "$type": "color", "$value": "{color.gray.700}" },
      "disabled":  { "$type": "color", "$value": "{color.gray.600}", "$description": "3.4:1 on white - do not use for body copy" },
      "on-primary":   { "$type": "color", "$value": "{color.gray.900}" },
      "on-secondary": { "$type": "color", "$value": "{color.gray.0}" }
    },
    "line": {
      "strong":  { "$type": "color", "$value": "{color.gray.300}" },
      "default": { "$type": "color", "$value": "{color.gray.250}" },
      "subtle":  { "$type": "color", "$value": "{color.gray.100}" }
    },
    "action": {
      "primary":          { "$type": "color", "$value": "{color.yellow.400}" },
      "primary-press":    { "$type": "color", "$value": "{color.yellow.500}" },
      "secondary":        { "$type": "color", "$value": "{color.gray.850}" },
      "secondary-press":  { "$type": "color", "$value": "{color.gray.900}" },
      "tertiary":         { "$type": "color", "$value": "{color.gray.0}" },
      "tertiary-press":   { "$type": "color", "$value": "{color.gray.100}" },
      "quaternary":       { "$type": "color", "$value": "{color.gray.250}" },
      "quaternary-press": { "$type": "color", "$value": "{color.gray.300}" },
      "cancel":           { "$type": "color", "$value": "{color.gray.400}" },
      "cancel-press":     { "$type": "color", "$value": "{color.gray.500}" },
      "highlight":        { "$type": "color", "$value": "{color.yellow.600}", "$description": "active tab, rating star, small accents on white" }
    }
  },

  "font": {
    "family": {
      "base": { "$type": "fontFamily", "$value": ["Pretendard Variable", "Pretendard", "-apple-system", "BlinkMacSystemFont", "Apple SD Gothic Neo", "Malgun Gothic", "sans-serif"], "$description": "source: web (only family detected)" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    }
  },

  "typography": {
    "display":  { "$type": "typography", "$value": { "fontFamily": "{font.family.base}", "fontSize": "44px", "fontWeight": 700, "lineHeight": 1.23 }, "$description": "web hero; mobile 28px (derived)" },
    "title-lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.base}", "fontSize": "24px", "fontWeight": 700, "lineHeight": 1.3 }, "$description": "web-usage 12; mobile 22px (derived)" },
    "title-md": { "$type": "typography", "$value": { "fontFamily": "{font.family.base}", "fontSize": "20px", "fontWeight": 700, "lineHeight": 1.4 }, "$description": "web-usage 65; mobile book title ~20px" },
    "title-sm": { "$type": "typography", "$value": { "fontFamily": "{font.family.base}", "fontSize": "18px", "fontWeight": 700, "lineHeight": 1.3 }, "$description": "web-usage 17; mobile header title ~18px" },
    "body-lg":  { "$type": "typography", "$value": { "fontFamily": "{font.family.base}", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.5 }, "$description": "web-usage 67" },
    "body-md":  { "$type": "typography", "$value": { "fontFamily": "{font.family.base}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.5 }, "$description": "web-usage 598 (dominant)" },
    "label":    { "$type": "typography", "$value": { "fontFamily": "{font.family.base}", "fontSize": "14px", "fontWeight": 600, "lineHeight": 1.29 }, "$description": "web buttons 14/600" },
    "caption":  { "$type": "typography", "$value": { "fontFamily": "{font.family.base}", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.4 }, "$description": "web-usage 170" },
    "micro":    { "$type": "typography", "$value": { "fontFamily": "{font.family.base}", "fontSize": "11px", "fontWeight": 600, "lineHeight": 1.3 }, "$description": "web-usage 11px=42, 10px=110; use 11px min for legibility (derived)" },
    "overline": { "$type": "typography", "$value": { "fontFamily": "{font.family.base}", "fontSize": "13px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "0.3em" }, "$description": "mobile 'ORIGINAL' label (estimated)" }
  },

  "space": {
    "0":  { "$type": "dimension", "$value": "0px" },
    "1":  { "$type": "dimension", "$value": "2px",  "$description": "web-usage 104" },
    "2":  { "$type": "dimension", "$value": "4px",  "$description": "web-usage 53" },
    "3":  { "$type": "dimension", "$value": "6px",  "$description": "web-usage 39 (5px=30 merged)" },
    "4":  { "$type": "dimension", "$value": "8px",  "$description": "web-usage 22 (7px merged)" },
    "5":  { "$type": "dimension", "$value": "12px", "$description": "web-usage 32 (10px merged)" },
    "6":  { "$type": "dimension", "$value": "16px", "$description": "web-usage 112 (14px merged)" },
    "7":  { "$type": "dimension", "$value": "20px", "$description": "web-usage 78; mobile page gutter" },
    "8":  { "$type": "dimension", "$value": "24px", "$description": "web-usage 9 (28px merged)" },
    "9":  { "$type": "dimension", "$value": "32px", "$description": "web-usage 29 (30/33px merged)" },
    "10": { "$type": "dimension", "$value": "40px" },
    "11": { "$type": "dimension", "$value": "48px", "$description": "derived (45px merged)" }
  },

  "radius": {
    "xs":   { "$type": "dimension", "$value": "4px",   "$description": "web small button / label (3.75px merged)" },
    "sm":   { "$type": "dimension", "$value": "8px",   "$description": "web-usage 7px=464 + 8px=310; book cover, card" },
    "md":   { "$type": "dimension", "$value": "12px",  "$description": "web buttons 10-12px; mobile category badge" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "xl":   { "$type": "dimension", "$value": "20px",  "$description": "web-usage 63; mobile picker card" },
    "2xl":  { "$type": "dimension", "$value": "28px",  "$description": "web modal; mobile bottom sheet top corners" },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "web 999px/100px; mobile hashtag chips" },
    "circle": { "$type": "dimension", "$value": "50%" }
  },

  "shadow": {
    "sm":    { "$type": "shadow", "$value": "0 1px 5px 0 rgba(0,0,0,0.12)", "$description": "source: web shadow-1" },
    "md":    { "$type": "shadow", "$value": "2px 2px 20px 0 rgba(0,0,0,0.06), 2px 2px 10px 0 rgba(0,0,0,0.04)", "$description": "source: web shadow-2" },
    "card":  { "$type": "shadow", "$value": "0 4px 24px 0 rgba(0,0,0,0.08)", "$description": "mobile picker card (estimated)" },
    "cover": { "$type": "shadow", "$value": "0 10px 24px 0 rgba(0,0,0,0.25)", "$description": "mobile book cover (estimated)" }
  },

  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms", "$description": "web-usage 24" },
      "base": { "$type": "duration", "$value": "200ms", "$description": "web-usage 5" },
      "slow": { "$type": "duration", "$value": "300ms", "$description": "web-usage 13" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1], "$description": "web-usage 26" }
    }
  },

  "breakpoint": {
    "mobile":  { "$type": "dimension", "$value": "0px",    "$description": "< 600px" },
    "tablet":  { "$type": "dimension", "$value": "600px",  "$description": "source: web media query 600/599" },
    "desktop": { "$type": "dimension", "$value": "1000px", "$description": "source: web media query 1000/999" },
    "wide":    { "$type": "dimension", "$value": "1280px", "$description": "source: web media query" }
  },

  "layout": {
    "gutter-mobile":  { "$type": "dimension", "$value": "20px", "$description": "mobile screenshots ~20-24px side margin" },
    "gutter-desktop": { "$type": "dimension", "$value": "32px" },
    "content-max":    { "$type": "dimension", "$value": "1080px", "$description": "derived" },
    "header-height":  { "$type": "dimension", "$value": "56px",  "$description": "mobile (estimated)" },
    "cta-height":     { "$type": "dimension", "$value": "56px",  "$description": "mobile bottom CTA bar (estimated)" },
    "tabbar-height":  { "$type": "dimension", "$value": "64px",  "$description": "mobile (estimated)" }
  }
}
